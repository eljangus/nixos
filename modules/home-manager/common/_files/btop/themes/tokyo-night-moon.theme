# Theme: Tokyo Night Moon
# Colours pulled from modules/home-manager/common/_files/kitty/themes/tokyo-night-moon.conf
# (the nixpkgs-bundled "tokyo-night" btop theme is the Night variant, not Moon)

# Main background
theme[main_bg]="#222436"

# Main text color
theme[main_fg]="#c8d3f5"

# Title color for boxes
theme[title]="#c8d3f5"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#82aaff"
# blue

# Background color of selected item in processes box
theme[selected_bg]="#2d3f76"
# selection_background

# Foreground color of selected item in processes box
theme[selected_fg]="#c8d3f5"

# Color of inactive/disabled text
theme[inactive_fg]="#3b4261"
# fg_gutter

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#828bb8"
# fg_dark

# Background color of the percentage meters
theme[meter_bg]="#3b4261"
# fg_gutter

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#82aaff"
# blue

# Cpu box outline color
theme[cpu_box]="#3b4261"
# fg_gutter

# Memory/disks box outline color
theme[mem_box]="#3b4261"
# fg_gutter

# Net up/down box outline color
theme[net_box]="#3b4261"
# fg_gutter

# Processes box outline color
theme[proc_box]="#3b4261"
# fg_gutter

# Box divider line and small boxes line color
theme[div_line]="#3b4261"
# fg_gutter

# Temperature graph colors
theme[temp_start]="#c3e88d"
# green
theme[temp_mid]="#ffc777"
# yellow
theme[temp_end]="#ff757f"
# red

# CPU graph colors
theme[cpu_start]="#c3e88d"
theme[cpu_mid]="#ffc777"
theme[cpu_end]="#ff757f"

# Mem/Disk free meter
theme[free_start]="#c3e88d"
theme[free_mid]="#c3e88d"
theme[free_end]="#c3e88d"
# green

# Mem/Disk cached meter
theme[cached_start]="#86e1fc"
theme[cached_mid]="#86e1fc"
theme[cached_end]="#86e1fc"
# cyan

# Mem/Disk available meter
theme[available_start]="#82aaff"
theme[available_mid]="#82aaff"
theme[available_end]="#82aaff"
# blue

# Mem/Disk used meter
theme[used_start]="#ff757f"
theme[used_mid]="#ff757f"
theme[used_end]="#ff757f"
# red

# Download graph colors
theme[download_start]="#82aaff"
theme[download_mid]="#86e1fc"
theme[download_end]="#86e1fc"
# blue to cyan

# Upload graph colors
theme[upload_start]="#c3e88d"
theme[upload_mid]="#ffc777"
theme[upload_end]="#ff757f"
# green to red

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#82aaff"
# blue
theme[process_mid]="#c099ff"
# purple
theme[process_end]="#ff757f"
# red
