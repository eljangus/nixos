/* Tokyo Night Moon (https://github.com/folke/tokyonight.nvim) */

* {
    bg:          #222436;
    bg-alt:      #1e2030;
    bg-selected: #2f334d;
    fg:          #c8d3f5;
    fg-alt:      #828bb8;
    accent:      #82aaff;
    border:      #3b4261;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    8px;
    width:            600px;
    padding:          10px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  10px;
}

inputbar {
    background-color: @bg-alt;
    text-color:        @fg;
    padding:            10px;
    border-radius:       6px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-alt;
}

listview {
    lines:     8;
    spacing:   4px;
    scrollbar: false;
}

element {
    padding:       8px;
    border-radius: 6px;
    text-color:    @fg-alt;
}

element selected {
    background-color: @bg-selected;
    text-color:        @fg;
    border:              0 0 0 2px;
    border-color:        @accent;
}

element-text {
    background-color: transparent;
    text-color:        inherit;
    vertical-align:     0.5;
}

element-icon {
    size: 1.2em;
}
