#!/usr/bin/env sh
# Catches eval-breaking mistakes before they land in a commit.
# Enable once per clone with: git config core.hooksPath .githooks

set -e

echo "Running nix flake check..."
if ! nix flake check --no-build; then
  echo
  echo "nix flake check failed — commit aborted."
  echo "Fix the error above, or skip with 'git commit --no-verify'."
  exit 1
fi
